MONGO_URL=mongodb://localhost:27017
DB_NAME=marketingapi
JWT_SECRET=replace-with-a-long-random-secret
# VAULT_KEY is optional. If omitted it is derived from JWT_SECRET.
VAULT_KEY=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium

# Meta WhatsApp webhook verification
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-token
META_API_VERSION=v21.0

# Cloud Scheduler / automation
CRON_SECRET=replace-with-a-random-cron-secret
ENABLE_IN_PROCESS_AUTOPILOT=false

# Production safety
SEED_DEMO_DATA=false
ENABLE_SIMULATION=false
ALLOWED_ORIGINS=
APP_ENV=development
